# Arc Bot deployment. Public identity and gas policy live in lib/project-config.ts.
NEXT_PUBLIC_SITE_URL=https://www.arcchainbot.io
NEXT_PUBLIC_CONVEX_URL=
# Deployment tooling only.
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=

# X posting: authorize these credentials as @ArcChainBot.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BOT_USER_ID=
X_REPLIES_ENABLED=false
# X website login: register https://www.arcchainbot.io/api/auth/x/callback.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# New shared secret in website and Convex.
WEB_AUTH_SECRET=

# Telegram identity has not been supplied. Configure the dedicated bot and URL.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_ARCBOT_TELEGRAM_URL=

# X operating policy. Direct tags bypass reply-depth limits.
X_REPLY_USER_DAILY_LIMIT=5000
X_REPLY_PREMIUM_DAILY_LIMIT=5000
X_REPLY_GLOBAL_DAILY_LIMIT=50000
X_REPLY_USER_WINDOW_LIMIT=10
X_REPLY_GLOBAL_WINDOW_LIMIT=500
X_REPLY_BUDGET_SCALE=0.5
X_REPLY_WINDOW_MINUTES=10
X_REPLY_COOLDOWN_SECONDS=0
X_STANDALONE_MENTIONS_ENABLED=false
X_STANDALONE_MENTIONS_SINCE_MS=0
X_SUPPRESS_ROUTINE_FAILURE_REPLIES=false
# Emergency premium intake filter only.
X_AUTO_INTAKE_GUARD_ENABLED=false
# Creation announcements stay disabled.
X_GRADUATION_POSTS_ENABLED=false

# Server-side command parsing and optional market data.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-5.6-luna
OPENROUTER_STRUCTURED_OUTPUTS_ENABLED=true
COINGECKO_PRO_API_KEY=
CSP_REPORT_ONLY=false

# Dedicated Arc Bot CDP project.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Wallet provisioning/signing integration. Legacy execution stays disabled in code.
WALLET_SIGNER_URL=
WALLET_SIGNER_TOKEN=
WALLET_SIGNER_IDEMPOTENCY_SECRET=

# Explicit mainnet provider endpoints and independently verified checkpoints.
# Do not substitute inherited RPCs or testnet endpoints.
ARC_MAINNET_RPC_URL=
ARC_CHECKPOINT_NUMBER=
ARC_CHECKPOINT_HASH=
BASE_MAINNET_RPC_URL=
BASE_CHECKPOINT_NUMBER=
BASE_CHECKPOINT_HASH=

# Shared managed-wallet reservation/settlement secret: website and Convex, >=32 chars.
# Worker URL derives from the fixed Arc Bot production domain in lib/project-config.ts.
OTC_SERVICE_SECRET=
# Verified Base payment contract and dedicated service-fee recipient.
OTC_BASE_PAYMENT_ROUTER=
OTC_BASE_ROUTER_CODE_HASH=
OTC_FEE_WALLET=
# Restricts older/operator spending; does not gate website OTC.
OTC_ENABLED=false

# Optional local operator CLI only, not website CDP signing.
ARC_SIGNER_PRIVATE_KEY=
ARC_JOURNAL_DIRECTORY=
BASE_SIGNER_PRIVATE_KEY=
BASE_JOURNAL_DIRECTORY=
